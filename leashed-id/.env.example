# Copy to .env and fill in. Never commit .env.

# LLM for /api/map-labels (server-side only). Leave empty to use the keyword mapper.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# real      = TideCloak + the Tide network (needs `npm run init` to have written tidecloak.json)
# simulated = a labelled stand-in for TideCloak sign-in, roles and the network (Plan C)
# Leave empty to pick automatically: real once tidecloak.json is provisioned, else simulated.
NEXT_PUBLIC_TIDE_MODE=simulated
